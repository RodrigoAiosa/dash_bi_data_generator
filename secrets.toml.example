# Copie este arquivo para .streamlit/secrets.toml (localmente) ou cole o
# conteúdo em Manage app > Settings > Secrets (Streamlit Cloud).
# NUNCA versione o secrets.toml de verdade, ele já está no .gitignore.
#
# Dados do "Session pooler" do Supabase (botão Connect no topo do painel).
# Use um usuário somente leitura, não o postgres.

[supabase]
host = "aws-0-us-west-2.pooler.supabase.com"
port = 5432
dbname = "postgres"
user = "dash_leitura.SEU_PROJECT_REF"
password = "SENHA_DO_USUARIO_DE_LEITURA"
